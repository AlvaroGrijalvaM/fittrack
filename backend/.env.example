# ====================== Conexión a MySQL ======================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fittrack

# ====================== Stripe (modo de prueba / sandbox) =====================
STRIPE_SECRET_KEY=
# Opcional: firma de webhooks
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ====================== API ======================
PORT=3000
# Cambia este secreto en producción
JWT_SECRET=cambia-este-secreto-en-produccion

# ====================== Notificaciones push (Expo) ======================
# Opcional. Si se deja vacío, las notificaciones se marcan como "simuladas".
# Genera un token en: https://expo.dev/accounts/<tu-cuenta>/settings/access-tokens
EXPO_ACCESS_TOKEN=

# ====================== CORS ======================
# URL que usará la app Expo para llamar a la API
# (en el frontend se configura con EXPO_PUBLIC_API_URL)
CORS_ORIGIN=*