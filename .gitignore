# =============================================================
# FitTrack — gitignore único para todo el proyecto (raíz)
# Cubre backend/ y frontend/
# =============================================================

# dependencias
node_modules/

# variables de entorno (secretos y configuración local)
.env
.env*.local
google-services.json

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# carpetas nativas generadas (prebuild)
ios/
android/
.kotlin/

# firmas y certificados
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# TypeScript
*.tsbuildinfo

# logs / debug
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# sistema
.DS_Store